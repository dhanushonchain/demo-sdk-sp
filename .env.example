# Copy to .env and fill in (server-only secrets — never commit .env).
# Point at your isolated StudentProof server, not production.
STUDENTPROOF_BASE=http://localhost:3118
STUDENTPROOF_ISSUER=http://localhost:3118
DEMO_CLIENT_ID=sp_client_demo-localhost-3117
DEMO_CLIENT_SECRET=paste-from-provision-script-output
DEMO_REDIRECT_URI=http://localhost:3117/auth/callback
DEMO_PORT=3117
# Signs the login/session cookies. Generate: openssl rand -hex 32
DEMO_COOKIE_SECRET=replace-with-64-hex-chars

# --- Vercel deployment ---
# 1. Set the env vars above in the Vercel dashboard (Project Settings → Environment Variables).
#    For a deployed app, set DEMO_REDIRECT_URI to:
#      https://<your-project>.vercel.app/auth/callback
#    so the StudentProof server allows the callback to your live domain.
# 2. vercel.json rewrites every path to the serverless function api/demo.mjs.
#    Also set DEMO_COOKIE_SECRET (openssl rand -hex 32) and STUDENTPROOF_BASE /
#    STUDENTPROOF_ISSUER to the production StudentProof origin.
# 3. `npx vercel` or connect a Git repo to deploy.
# NOTE: DEMO_PORT is ignored on Vercel — the serverless runtime assigns the port.
